<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#F5F5F5">

    <!-- 戻るボタンとモード表示 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="メニューへ"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/modeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="買物モード"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/shelfMapButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="棚位置"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </LinearLayout>

    <!-- カメラビュー -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#222222"
        app:scaleType="fitCenter" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/parentCodeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="親品番："
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <Button
            android:id="@+id/resetParentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="親品番リセット"
            android:textSize="12sp" />


    </LinearLayout>

    <!-- 読み取り状況 -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center"
        android:padding="4dp"
        android:text="親品番のQRコードを読み取ってください"
        android:textColor="#222222"
        android:textSize="12sp" />

    <!-- 中央の分割ビュー -->
    <!-- 親品番読み取り後に表示 -->
    <LinearLayout
        android:id="@+id/splitView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone"
        android:weightSum="2">

        <!-- 上側：親品番表示 -->
        <FrameLayout
            android:id="@+id/topPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/topCodeText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="4dp"
                android:text="親品番のQRコードを&#10;読み込んでください"
                android:textColor="#000000"
                android:textSize="14sp"
                android:background="@android:color/transparent" />

        </FrameLayout>

        <!-- 下側：供給QRの案内 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/bottomStatusText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="8dp"
                android:text="ロケQRをスキャンしてください"
                android:textColor="#000000"
                android:textSize="24sp" />

        </FrameLayout>

    </LinearLayout>

    <!-- 読み取りボタン -->
    <Button
        android:id="@+id/readButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="56dp"
        android:text="読み取り"
        android:textSize="18sp" />

</LinearLayout>
